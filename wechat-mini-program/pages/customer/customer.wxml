<view class="page-shell">
  <view wx:if="{{serviceMessage}}" class="service-message">
    <text class="service-message-text">{{serviceMessage}}</text>
    <button class="service-retry-button" loading="{{isSyncingRemote}}" disabled="{{isSyncingRemote}}" bindtap="retryRemoteSync">重试</button>
  </view>
  <view wx:if="{{activeView === 'home'}}" class="topbar">
    <view class="brand-block">
      <view class="brand-mark serif">{{settings.brandMark}}</view>
      <view>
        <view class="brand-name serif">{{settings.brandName}}</view>
        <view class="brand-tagline">{{settings.brandTagline}}</view>
      </view>
    </view>
    <button class="role-button" bindtap="openAccountEntry">{{merchantSessionToken ? '我的' : '登录'}}</button>
  </view>

  <block wx:if="{{activeView === 'home'}}">
    <view class="hero {{settings.heroBackgroundPath ? 'hero-with-image' : ''}}">
      <image wx:if="{{settings.heroBackgroundPath}}" class="hero-background" src="{{settings.heroBackgroundPath}}" mode="aspectFill" />
      <view wx:if="{{settings.heroBackgroundPath}}" class="hero-overlay" />
      <view class="hero-copy {{settings.heroBackgroundPath ? 'hero-copy-card' : ''}}">
        <view class="hero-badge">{{settings.heroBadge}}</view>
        <view class="hero-title serif">{{settings.heroTitle}}</view>
        <view class="hero-description">{{settings.heroDescription}}</view>
        <view class="hero-actions">
          <button class="primary-button hero-button" data-view="shop" bindtap="setActiveView">{{settings.heroButtonText}}</button>
          <view class="delivery-note">{{settings.deliveryNote}}</view>
        </view>
      </view>
      <view wx:if="{{!settings.heroBackgroundPath}}" class="hero-art" aria-hidden="true">
        <view class="steam steam-one" />
        <view class="steam steam-two" />
        <view class="steam steam-three" />
        <view class="tray" />
        <view class="hero-bun hero-bun-one bun bun-wheat" />
        <view class="hero-bun hero-bun-two bun bun-corn" />
        <view class="hero-bun hero-bun-three bun bun-brown" />
        <view class="stamp">今日\n现蒸</view>
      </view>
    </view>

  </block>
  <block wx:elif="{{activeView === 'shop'}}">
    <view id="menu" class="content menu-section">
      <view class="section-title">今日馒头</view>
      <view class="section-description">按单现蒸，数量有限。体验版商品和库存由本机商家端管理。</view>
      <view class="menu-catalog">
        <view class="category-list">
          <button
            wx:for="{{categories}}"
            wx:key="*this"
            class="category-chip {{activeCategory === item ? 'category-active' : ''}}"
            data-category="{{item}}"
            bindtap="selectCategory"
          ><text class="category-label">{{item}}</text></button>
        </view>

        <view class="product-grid">
          <view wx:for="{{visibleProducts}}" wx:key="id" class="product-card card" data-id="{{item.id}}" bindtap="openProductDetail">
            <view class="product-visual">
              <view wx:if="{{item.badge}}" class="product-badge">{{item.badge}}</view>
              <image wx:if="{{item.imagePath}}" class="product-image" src="{{item.imagePath}}" mode="aspectFill" />
              <view wx:else class="bun {{item.toneClass}}">
                <view class="bun-fold fold-one" />
                <view class="bun-fold fold-two" />
                <view class="bun-fold fold-three" />
              </view>
            </view>
            <view class="product-content">
              <view class="product-name serif">{{item.name}}</view>
              <view class="product-description">{{item.description}}</view>
              <view class="product-stock">余 {{item.stock}} {{item.unit}}</view>
              <view class="product-footer">
                <view class="product-price-wrap"><text class="product-price serif">{{item.priceText}}</text><text class="product-unit">/{{item.unit}}</text></view>
                <view class="quantity-control">
                  <button wx:if="{{item.quantity > 0}}" class="quantity-button" data-id="{{item.id}}" catchtap="removeFromCart">−</button>
                  <text wx:if="{{item.quantity > 0}}" class="quantity-value">{{item.quantity}}</text>
                  <button class="quantity-button quantity-add" data-id="{{item.id}}" catchtap="addToCart">+</button>
                </view>
              </view>
            </view>
          </view>
        </view>
      </view>
    </view>
  </block>

  <view wx:elif="{{activeView === 'cart'}}" class="content view-content">
    <view class="section-title">选好的馒头</view>
    <view class="section-description">确认数量，留下预约信息后即可生成本机体验订单。</view>

    <view wx:if="{{cartItems.length === 0}}" class="empty-state card">
      <view class="empty-mark">笼</view>
      <view class="serif empty-title">蒸笼还是空的</view>
      <view class="section-description">先去挑几样今天想吃的馒头吧。</view>
      <button class="primary-button empty-button" data-view="shop" bindtap="setActiveView">去点单</button>
    </view>

    <block wx:else>
      <view class="cart-list">
        <view wx:for="{{cartItems}}" wx:key="id" class="cart-item card">
          <view class="cart-visual">
            <image wx:if="{{item.imagePath}}" class="product-image" src="{{item.imagePath}}" mode="aspectFill" />
            <view wx:else class="bun mini-bun {{item.toneClass}}" />
          </view>
          <view class="cart-info">
            <view class="cart-name serif">{{item.name}}</view>
            <view class="cart-subtotal">{{item.subtotalText}}</view>
          </view>
          <view class="quantity-control">
            <button class="quantity-button" data-id="{{item.id}}" bindtap="removeFromCart">−</button>
            <text class="quantity-value">{{item.quantity}}</text>
            <button class="quantity-button quantity-add" data-id="{{item.id}}" bindtap="addToCart">+</button>
          </view>
        </view>
      </view>

      <view class="checkout-card card">
        <view class="checkout-heading">
          <view class="serif checkout-title">取餐方式与订单信息</view>
          <view class="serif checkout-total">{{payableTotalText}}</view>
        </view>

        <view class="fulfillment-grid">
          <button class="fulfillment-option {{fulfillment === 'pickup' ? 'fulfillment-active' : ''}}" data-value="pickup" bindtap="selectFulfillment">
            <text>到店自提</text><text class="option-note">生成 A 开头取餐号</text>
          </button>
          <button class="fulfillment-option {{fulfillment === 'delivery' ? 'fulfillment-active' : ''}}" data-value="delivery" bindtap="selectFulfillment">
            <text>配送到家</text><text class="option-note">3km内 · 满30元免配送费</text>
          </button>
        </view>

        <view class="form-field">
          <text class="field-label">{{fulfillment === 'pickup' ? '姓名/称呼' : '收货人'}}</text>
          <input class="field-input" value="{{customerName}}" placeholder="{{fulfillment === 'pickup' ? '怎么称呼您' : '请输入收货人姓名'}}" data-field="customerName" bindinput="updateField" />
        </view>
        <view class="form-field">
          <text class="field-label">手机号</text>
          <input class="field-input" value="{{phone}}" type="number" maxlength="11" placeholder="用于确认订单" data-field="phone" bindinput="updateField" />
        </view>

        <view wx:if="{{fulfillment === 'delivery'}}">
          <view class="form-field">
            <text class="field-label">可配送区域</text>
            <picker mode="selector" range="{{deliveryAreas}}" value="{{deliveryAreaIndex}}" bindchange="changeDeliveryArea">
              <view class="field-picker">{{deliveryAreas[deliveryAreaIndex]}}</view>
            </picker>
          </view>
          <view class="form-field">
            <text class="field-label">门牌号</text>
            <input class="field-input" value="{{doorNumber}}" placeholder="楼栋、单元、房间号" data-field="doorNumber" bindinput="updateField" />
          </view>
        </view>

        <view class="picker-grid">
          <view class="form-field">
            <text class="field-label">{{fulfillment === 'pickup' ? '取餐日期' : '送达日期'}}</text>
            <picker mode="selector" range="{{pickupDays}}" value="{{pickupDayIndex}}" bindchange="changePickupDay">
              <view class="field-picker">{{pickupDays[pickupDayIndex]}}</view>
            </picker>
          </view>
          <view wx:if="{{fulfillment === 'pickup'}}" class="form-field">
            <text class="field-label">预计取餐时间</text>
            <picker mode="selector" range="{{pickupTimes}}" value="{{pickupTimeIndex}}" bindchange="changePickupTime">
              <view class="field-picker">{{pickupTimes[pickupTimeIndex]}}</view>
            </picker>
          </view>
          <view wx:else class="form-field">
            <text class="field-label">预计送达时间</text>
            <picker mode="selector" range="{{deliveryTimes}}" value="{{deliveryTimeIndex}}" bindchange="changeDeliveryTime">
              <view class="field-picker">{{deliveryTimes[deliveryTimeIndex]}}</view>
            </picker>
          </view>
        </view>

        <view class="form-field">
          <text class="field-label">备注</text>
          <textarea class="field-textarea" value="{{note}}" maxlength="100" placeholder="例如：少装塑料袋" data-field="note" bindinput="updateField" />
        </view>
        <view wx:if="{{fulfillment === 'delivery'}}" class="delivery-note">配送范围：本店 3km 内 · 15元起送 · 配送费3元 · 满30元免配送费</view>
        <view class="order-summary">
          <view>商品金额：{{cartTotalText}}</view>
          <view>配送费：{{deliveryFeeText}}</view>
          <view class="serif order-total">应付金额：{{payableTotalText}}</view>
        </view>
        <button class="primary-button submit-button" loading="{{isSubmittingOrder}}" disabled="{{isSubmittingOrder}}" bindtap="submitOrder">确认订单并显示收款码 · {{payableTotalText}}</button>
        <view class="local-tip">提交成功后显示订单金额和商家个人收款码；到账仍由商家人工核验。</view>
      </view>
    </block>
  </view>

  <view wx:elif="{{activeView === 'profile'}}" class="profile-page">
    <view class="content view-content profile-info">
      <view class="profile-header card">
        <view class="profile-avatar serif">{{profileName ? profileName.slice(0, 1) : profileLabels.avatar}}</view>
        <view class="profile-summary">
          <view class="profile-title serif">{{profileName || profileLabels.guest}}</view>
          <view class="profile-status">{{profileSaved ? profileLabels.saved : profileLabels.unsaved}}</view>
        </view>
        <view class="profile-channel-badge">小程序</view>
      </view>

      <view class="profile-account-card card">
        <block wx:if="{{merchantSessionToken && merchantAccount}}">
          <view class="profile-account-identity">
            <view class="profile-account-mark serif">账</view>
            <view class="profile-account-copy">
              <view class="profile-account-name serif">{{merchantAccount.displayName}}</view>
              <view class="profile-account-meta">@{{merchantAccount.username}} · {{merchantRoleLabel}}</view>
            </view>
          </view>
          <view class="profile-account-actions">
            <button wx:if="{{canOpenMerchant}}" class="secondary-button compact-button" bindtap="openAdmin">进入商家端</button>
            <button wx:if="{{canOpenManagement}}" class="secondary-button compact-button" bindtap="openManagement">系统管理</button>
            <button class="secondary-button compact-button account-logout-button" bindtap="logoutAccount">退出登录</button>
          </view>
        </block>
        <block wx:else>
          <view class="profile-account-identity">
            <view class="profile-account-mark serif">账</view>
            <view class="profile-account-copy">
              <view class="profile-account-name serif">登录账号</view>
              <view class="profile-account-meta">顾客与商家使用统一账号入口</view>
            </view>
          </view>
          <button class="secondary-button compact-button" bindtap="openAccountEntry">登录</button>
        </block>
      </view>

      <view class="profile-order-entry card" data-view="orders" bindtap="setActiveView" role="button" aria-label="进入我的订单">
        <view class="profile-order-icon serif">单</view>
        <view class="profile-order-copy">
          <view class="profile-order-title serif">我的订单</view>
          <view class="profile-order-description">{{latestOrderStatusText}}</view>
        </view>
        <view class="profile-order-metrics">
          <view><text>{{orderCount}}</text><text>全部</text></view>
          <view><text>{{activeOrderCount}}</text><text>进行中</text></view>
        </view>
        <view class="profile-order-arrow">›</view>
      </view>

      <view class="profile-card card">
        <view class="section-title profile-section-title">{{profileLabels.title}}</view>
        <view class="section-description">{{profileLabels.description}}</view>
        <view class="form-field profile-first-field">
          <text class="field-label">{{profileLabels.name}}</text>
          <input class="field-input" value="{{profileName}}" maxlength="20" placeholder="{{profileLabels.namePlaceholder}}" data-field="profileName" bindinput="updateProfileField" />
        </view>
        <view class="form-field">
          <text class="field-label">{{profileLabels.phone}}</text>
          <input class="field-input" value="{{profilePhone}}" type="number" maxlength="11" placeholder="{{profileLabels.phonePlaceholder}}" data-field="profilePhone" bindinput="updateProfileField" />
        </view>
        <view class="form-field">
          <text class="field-label">{{profileLabels.address}}</text>
          <input class="field-input" value="{{profileAddress}}" maxlength="80" placeholder="{{profileLabels.addressPlaceholder}}" data-field="profileAddress" bindinput="updateProfileField" />
        </view>
        <view class="form-field">
          <text class="field-label">{{profileLabels.note}}</text>
          <textarea class="field-textarea profile-textarea" value="{{profileNote}}" maxlength="100" placeholder="{{profileLabels.notePlaceholder}}" data-field="profileNote" bindinput="updateProfileField" />
        </view>
        <button class="primary-button profile-save" bindtap="saveCustomerProfile">{{profileLabels.save}}</button>
        <view class="local-tip">{{profileLabels.localTip}}</view>
      </view>
    </view>
  </view>

  <view wx:elif="{{activeView === 'orders'}}" class="content view-content secondary-orders-page">
    <view class="secondary-orders-heading">
      <button class="secondary-back-button" data-view="profile" bindtap="setActiveView" aria-label="返回个人中心">←</button>
      <view>
        <view class="secondary-eyebrow">个人中心 · 预约进度</view>
        <view class="section-title">我的订单</view>
      </view>
    </view>
    <view class="section-description secondary-orders-description">小程序与网页版订单实时同步，付款状态以商家人工核验为准。</view>
    <view wx:if="{{orders.length === 0}}" class="empty-state card">
      <view class="empty-mark">单</view>
      <view class="serif empty-title">还没有预约</view>
      <view class="section-description">先去挑几样今天想吃的馒头吧。</view>
      <button class="primary-button empty-button" data-view="shop" bindtap="setActiveView">去点单</button>
    </view>
    <view wx:else class="order-list">
      <view wx:for="{{orders}}" wx:key="id" class="order-card card">
        <view class="order-heading">
          <view>
            <view class="serif order-title">{{item.shortCode}}【{{item.fulfillment === 'pickup' ? '自提' : '配送'}}】</view>
            <view class="order-id">#{{item.id}} · {{item.createdAtText}}</view>
          </view>
          <view class="order-status status-{{item.status}}">{{item.statusText}}</view>
        </view>
        <view class="order-divider" />
        <view class="order-summary">{{item.itemSummary}}</view>
        <view wx:if="{{item.deliveryAddressText}}" class="customer-info">地址：{{item.deliveryAddressText}}</view>
        <view class="appointment">{{item.appointmentText}}</view>
        <view wx:if="{{item.fulfillment === 'delivery'}}" class="payment-status">配送进度：{{item.deliveryStatusText}}</view>
        <view class="payment-status">{{item.paymentStatusText}}</view>
        <view wx:if="{{item.paymentMethodName}}" class="payment-status">收款方式：{{item.paymentMethodName}}</view>
        <view class="order-bottom"><text>商品 {{item.subtotalText}} · 配送费 {{item.deliveryFeeText}}</text><text class="serif order-total">应付 {{item.totalText}}</text></view>
        <view wx:if="{{item.canShowPaymentCode}}" class="payment-actions">
          <picker mode="selector" range="{{paymentMethodLabels}}" bindchange="selectPaymentMethod">
            <view class="secondary-payment-button">选择收款码</view>
          </picker>
          <button class="secondary-payment-button" bindtap="showPaymentCode">查看二维码</button>
          <button wx:if="{{item.canSubmitPayment}}" class="primary-payment-button" data-id="{{item.id}}" bindtap="markOrderPaid">我已付款</button>
        </view>
      </view>
    </view>
  </view>
  <view wx:if="{{selectedProduct}}" class="product-modal" bindtap="closeProductDetail">
    <view class="product-detail card" catchtap="stopPropagation">
      <button class="detail-close" catchtap="closeProductDetail" aria-label="关闭商品详情">×</button>
      <view class="detail-visual">
        <view wx:if="{{selectedProduct.badge}}" class="product-badge">{{selectedProduct.badge}}</view>
        <image wx:if="{{selectedProduct.imagePath}}" class="product-image" src="{{selectedProduct.imagePath}}" mode="aspectFill" />
        <view wx:else class="bun detail-bun {{selectedProduct.toneClass}}">
          <view class="bun-fold fold-one" />
          <view class="bun-fold fold-two" />
          <view class="bun-fold fold-three" />
        </view>
      </view>
      <view class="detail-category">{{selectedProduct.category}} · 每日现蒸</view>
      <view class="detail-name serif">{{selectedProduct.name}}</view>
      <view class="detail-description">{{selectedProduct.description}}</view>
      <view class="detail-stock">当前库存：{{selectedProduct.stock}} {{selectedProduct.unit}}</view>
      <view class="detail-footer">
        <view><text class="detail-price serif">{{selectedProduct.priceText}}</text><text class="product-unit"> / {{selectedProduct.unit}}</text></view>
        <view class="quantity-control">
          <button wx:if="{{selectedProduct.quantity > 0}}" class="quantity-button" data-id="{{selectedProduct.id}}" catchtap="removeFromCart">−</button>
          <text wx:if="{{selectedProduct.quantity > 0}}" class="quantity-value">{{selectedProduct.quantity}}</text>
          <button class="quantity-button quantity-add" data-id="{{selectedProduct.id}}" catchtap="addToCart">+</button>
        </view>
      </view>
    </view>
  </view>

  <view class="bottom-nav {{canOpenManagement ? 'has-management' : ''}}">
    <button class="nav-item {{activeView === 'home' ? 'nav-active' : ''}}" data-view="home" bindtap="setActiveView"><text class="nav-icon">{{navLabels.homeIcon}}</text><text>{{navLabels.home}}</text></button>
    <button class="nav-item {{activeView === 'shop' ? 'nav-active' : ''}}" data-view="shop" bindtap="setActiveView"><text class="nav-icon">馒</text><text>点单</text></button>
    <button class="nav-item {{activeView === 'cart' ? 'nav-active' : ''}}" data-view="cart" bindtap="setActiveView"><text class="nav-icon">笼</text><text>{{navLabels.cart}}</text><text wx:if="{{cartCount > 0}}" class="cart-badge">{{cartCount}}</text></button>
    <button class="nav-item {{activeView === 'profile' || activeView === 'orders' ? 'nav-active' : ''}}" data-view="profile" bindtap="setActiveView"><text class="nav-icon">{{navLabels.profileIcon}}</text><text>{{navLabels.profile}}</text></button>
    <button wx:if="{{canOpenManagement}}" class="nav-item" bindtap="openManagement"><text class="nav-icon">管</text><text>管理</text></button>
  </view>
</view>
