  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-card .product-stock {
  margin-top: 7rpx;
}

.product-card .product-footer {
  margin-top: 12rpx;
}

.product-card .product-price {
  color: #d7553f;
}

.quantity-add {
  border-color: var(--sage-dark);
  background: var(--sage-dark);
}

@media (max-width: 360px), (max-height: 700px) {
  .menu-catalog { grid-template-columns: 112rpx minmax(0, 1fr); }
  .category-chip { min-height: 82rpx; }
  .product-card { min-height: 176rpx; padding: 18rpx 14rpx; gap: 12rpx; }
  .product-card .product-visual { width: 116rpx; height: 116rpx; flex-basis: 116rpx; }
}

@media (min-width: 600px) {
  .menu-catalog { grid-template-columns: 150rpx minmax(0, 1fr); }
  .product-grid { display: flex; }
  .product-card .product-visual { width: 160rpx; height: 160rpx; flex-basis: 160rpx; }
}

/* ????? button ? Grid/Sticky ????????????????? Flex ??? */
.menu-catalog {
  --category-width: 132rpx;
  display: flex;
  width: 100%;
  align-items: stretch;
}

.menu-catalog .category-list {
  position: relative;
  top: auto;
  display: flex;
  width: var(--category-width);
  min-width: var(--category-width);
  flex: 0 0 var(--category-width);
  align-self: stretch;
  overflow: hidden;
}

.menu-catalog .category-chip {
  display: flex;
  width: var(--category-width);
  min-width: var(--category-width);
  max-width: var(--category-width);
  margin: 0;
  padding: 0 10rpx;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  line-height: 1.3;
  text-align: center;
}

.category-label {
  display: block;
  width: 100%;
  overflow: hidden;
  line-height: 1.3;
  text-align: center;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.menu-catalog .product-grid {
  display: flex;
  width: auto;
  min-width: 0;
  flex: 1 1 0;
  flex-direction: column;
}

.menu-catalog .product-card {
  width: 100%;
  min-width: 0;
  flex: 0 0 auto;
  box-sizing: border-box;
}

.menu-catalog .product-content {
  display: flex;
  min-width: 0;
  flex: 1 1 0;
  flex-direction: column;
  justify-content: center;
  overflow: hidden;
}

.menu-catalog .product-name,
.menu-catalog .product-description,
.menu-catalog .product-stock {
  position: static;
  display: block;
  width: 100%;
  min-width: 0;
}

.menu-catalog .product-footer {
  width: 100%;
  min-width: 0;
}

.product-price-wrap {
  min-width: 0;
  white-space: nowrap;
}

@media (max-width: 360px), (max-height: 700px) {
  .menu-catalog {
    --category-width: 112rpx;
  }
}

@media (min-width: 600px) {
  .menu-catalog {
    --category-width: 150rpx;
  }
}


/* Five-item navigation and local customer profile. */
.bottom-nav {
  grid-template-columns: repeat(4, minmax(0, 1fr));
}

.nav-item {
  min-width: 0;
  padding: 0 4rpx;
  font-size: 18rpx;
  line-height: 1.2;
}

.nav-icon {
  font-size: 26rpx;
  line-height: 1.1;
}

.profile-channel-badge {
  flex: 0 0 auto;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(89, 105, 77, 0.12);
  color: var(--sage-dark);
  font-size: 19rpx;
  font-weight: 600;
}

.profile-order-entry {
  display: grid;
  width: 100%;
  min-width: 0;
  margin-top: 24rpx;
  padding: 28rpx;
  grid-template-columns: 76rpx minmax(0, 1fr) auto 24rpx;
  align-items: center;
  gap: 20rpx;
  box-sizing: border-box;
  color: var(--stone);
  line-height: 1.4;
  text-align: left;
  white-space: normal;
}

.profile-order-icon {
  display: flex;
  width: 76rpx;
  height: 76rpx;
  flex: 0 0 76rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50% 44% 48% 46%;
  background: #e3e7dc;
  color: var(--sage-dark);
  font-size: 30rpx;
}

.profile-order-copy { width: 100%; min-width: 0; }
.profile-order-title { overflow: hidden; font-size: 32rpx; text-overflow: ellipsis; white-space: nowrap; }

.profile-order-description {
  margin-top: 8rpx;
  overflow: hidden;
  color: #78716c;
  font-size: 20rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-order-metrics {
  display: flex;
  flex: 0 0 auto;
  gap: 18rpx;
}

.profile-order-metrics view { display: flex; flex-direction: column; align-items: center; }
.profile-order-metrics text:first-child { color: var(--sage-dark); font-family: Georgia, serif; font-size: 29rpx; font-weight: 600; }
.profile-order-metrics text:last-child { color: #8a8179; font-size: 17rpx; }
.profile-order-arrow { color: #8a8179; font-size: 42rpx; font-weight: 300; }

.secondary-orders-page { min-height: calc(100vh - 130rpx); }

.secondary-orders-heading {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.secondary-back-button {
  display: flex;
  width: 72rpx;
  height: 72rpx;
  margin: 0;
  padding: 0;
  flex: 0 0 72rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #d6d3d1;
  border-radius: 50%;
  background: #fffdf9;
  color: var(--stone);
  font-size: 32rpx;
  line-height: 1;
}

.secondary-back-button::after { border: 0; }
.secondary-eyebrow { color: #78716c; font-size: 21rpx; }
.secondary-orders-description { margin-top: 20rpx; }

.profile-page {
  min-height: calc(100vh - 130rpx);
}

.profile-header {
  display: flex;
  padding: 28rpx;
  align-items: center;
  gap: 22rpx;
}

.profile-avatar {
  display: flex;
  width: 92rpx;
  height: 92rpx;
  flex: 0 0 92rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: var(--sage-dark);
  color: #fffdf9;
  font-size: 36rpx;
}

.profile-summary { min-width: 0; flex: 1; }

.profile-title {
  overflow: hidden;
  font-size: 34rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-status {
  margin-top: 8rpx;
  color: #78716c;
  font-size: 20rpx;
}

.profile-card {
  margin-top: 24rpx;
  padding: 30rpx;
}

.profile-section-title { font-size: 38rpx; }
.profile-first-field { margin-top: 30rpx; }
.profile-textarea { min-height: 150rpx; }
.profile-save { width: 100%; }

@media (max-width: 360px), (max-height: 700px) {
  .nav-item {
    min-height: 78rpx;
    font-size: 16rpx;
  }

  .nav-icon { font-size: 23rpx; }
  .profile-card { padding: 24rpx; }
  .profile-order-metrics { display: none; }
  .profile-order-entry { padding: 24rpx; grid-template-columns: 68rpx minmax(0, 1fr) 20rpx; gap: 16rpx; }
  .profile-order-icon { width: 68rpx; height: 68rpx; flex-basis: 68rpx; }
}

/* Stable four-column navigation: avoid translated fixed widths on WeChat simulators. */
.bottom-nav {
  right: var(--page-gutter);
  left: var(--page-gutter);
  width: auto;
  max-width: 760rpx;
  margin: 0 auto;
  transform: none;
  box-sizing: border-box;
  grid-template-columns: repeat(4, minmax(0, 1fr));
}

.bottom-nav .nav-item {
  width: 100%;
  min-width: 0;
  max-width: none;
  margin: 0;
  padding: 0 2rpx;
  overflow: hidden;
  box-sizing: border-box;
  text-align: center;
}

.bottom-nav .nav-item > text {
  display: block;
  width: 100%;
  overflow: hidden;
  text-align: center;
  text-overflow: clip;
  white-space: nowrap;
}

@media (min-width: 600px) {
  .bottom-nav {
    right: var(--page-gutter);
    left: var(--page-gutter);
    width: auto;
    transform: none;
  }
}
