  border-radius: 0;
  background: transparent;
}

.product-card:last-child { border-bottom: 0; }

.product-card .product-visual {
  width: 142rpx;
  height: 142rpx;
  flex: 0 0 142rpx;
  border-radius: 24rpx 30rpx 26rpx 32rpx;
}

.product-card .product-content {
  min-width: 0;
  flex: 1;
}

.product-card .product-name {
