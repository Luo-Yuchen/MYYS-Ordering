.topbar {
  display: flex;
  min-height: 112rpx;
  padding: 18rpx var(--page-gutter);
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  background: rgba(255, 253, 249, 0.96);
}

.brand-block {
  display: flex;
  min-width: 0;
  align-items: center;
  gap: 20rpx;
}

.brand-mark {
  display: flex;
  width: 66rpx;
  height: 66rpx;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  border-radius: 50% 43% 48% 45%;
  background: var(--sage-dark);
  color: #fffdf9;
  font-size: 30rpx;
  transform: rotate(-3deg);
}

.brand-name {
  font-size: 34rpx;
  line-height: 1.2;
}

.brand-tagline {
  margin-top: 5rpx;
  overflow: hidden;
  color: #78716c;
  font-size: 20rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.role-button {
  flex: 0 0 auto;
  min-width: 146rpx;
  min-height: var(--control-height);
  padding: 0 24rpx;
  border: 1rpx solid #d6d3d1;
  border-radius: 999rpx;
  background: transparent;
  color: #44403c;
  font-size: 24rpx;
}

.hero {
  position: relative;
  min-height: 780rpx;
  overflow: hidden;
  padding: 72rpx 36rpx 46rpx;
  background: var(--sage);
}

.hero-with-image {
  display: flex;
  min-height: 860rpx;
  align-items: flex-end;
}

.hero-background,
.hero-overlay {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.hero-overlay {
  background: rgba(49, 43, 36, 0.22);
}

.hero-copy {
  position: relative;
  z-index: 3;
}

.hero-copy-card {
  width: 100%;
  padding: 34rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.75);
  border-radius: 42rpx 56rpx 44rpx 52rpx;
  background: rgba(250, 246, 241, 0.92);
}

.hero-badge {
  display: inline-flex;
  padding: 12rpx 24rpx;
  border: 1rpx solid rgba(41, 37, 36, 0.3);
  border-radius: 50% 44% 48% 46%;
  background: rgba(250, 246, 241, 0.35);
  font-size: 21rpx;
  transform: rotate(-1deg);
}

.hero-title {
  max-width: 650rpx;
  margin-top: 40rpx;
  font-size: 66rpx;
  font-weight: 500;
  line-height: 1.18;
  white-space: pre-line;
}

.hero-description {
  max-width: 650rpx;
  margin-top: 28rpx;
  color: #3f3a35;
  font-size: 26rpx;
  line-height: 1.85;
}

.hero-actions {
  display: flex;
  margin-top: 34rpx;
  align-items: center;
  gap: 22rpx;
}

.hero-button {
  min-width: 240rpx;
  padding: 0 28rpx;
  font-size: 25rpx;
}

.delivery-note {
  flex: 1;
  color: #4c4742;
  font-size: 21rpx;
  line-height: 1.5;
}

.hero-art {
  position: relative;
  z-index: 2;
  min-height: 360rpx;
  margin-top: 20rpx;
}

.tray {
  position: absolute;
  left: 50%;
  bottom: 20rpx;
  width: 560rpx;
  height: 142rpx;
  transform: translateX(-50%);
  border: 20rpx solid #9b6841;
  border-radius: 48% 52% 44% 56%;
  background: #c99462;
  box-shadow: inset 0 -20rpx 0 rgba(94, 55, 31, 0.16), 0 14rpx 28rpx rgba(56, 45, 34, 0.14);
}

.steam {
  position: absolute;
  width: 44rpx;
  height: 120rpx;
  border-left: 5rpx solid rgba(250, 246, 241, 0.55);
  border-radius: 50%;
}

.steam-one { left: 32%; top: 10rpx; transform: rotate(10deg); }
.steam-two { left: 50%; top: -12rpx; transform: rotate(-8deg); }
.steam-three { left: 67%; top: 26rpx; transform: rotate(13deg); }

.hero-bun {
  position: absolute;
  z-index: 2;
  width: 174rpx;
  height: 154rpx;
}

.hero-bun-one { left: calc(50% - 210rpx); bottom: 116rpx; transform: rotate(-8deg); }
.hero-bun-two { left: calc(50% + 34rpx); bottom: 128rpx; transform: rotate(6deg); }
.hero-bun-three { left: calc(50% - 88rpx); bottom: 190rpx; transform: rotate(2deg); }

.stamp {
  position: absolute;
  z-index: 4;
  right: 22rpx;
  top: 38rpx;
  display: flex;
  width: 104rpx;
  height: 104rpx;
  align-items: center;
  justify-content: center;
  border: 3rpx solid #5e3d2d;
  border-radius: 48% 52% 46% 54%;
  color: #5e3d2d;
  font-family: "Kaiti SC", STKaiti, serif;
  font-size: 24rpx;
  line-height: 1.2;
  text-align: center;
  white-space: pre-line;
  transform: rotate(8deg);
}

.menu-section {
  padding-top: 40rpx;
}

.menu-catalog {
  display: grid;
  grid-template-columns: 112rpx minmax(0, 1fr);
  margin-top: 24rpx;
  align-items: start;
  gap: 16rpx;
}

.category-list {
  position: sticky;
  top: 16rpx;
  display: flex;
  min-width: 0;
  flex-direction: column;
  gap: 12rpx;
}

.category-chip {
  display: flex;
  width: 100%;
  min-width: 0;
  min-height: 78rpx;
  padding: 8rpx 10rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #d6d3d1;
  border-radius: 24rpx 30rpx 26rpx 32rpx;
  background: transparent;
  color: #57534e;
  font-size: 22rpx;
  line-height: 1.2;
}

.category-active {
  border-color: var(--stone);
  background: var(--stone);
  color: #fafaf9;
}

.product-grid,
.cart-list,
.order-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.product-grid {
  display: grid;
  min-width: 0;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  align-items: start;
  gap: 16rpx;
}

.product-card {
  min-width: 0;
  padding: 12rpx;
}

.product-visual {
  position: relative;
  display: flex;
  height: 176rpx;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: 46% 54% 48% 52%;
  background: #eee4d8;
}

.product-image {
  width: 100%;
  height: 100%;
}

.product-badge {
  position: absolute;
  z-index: 4;
  left: 10rpx;
  top: 10rpx;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: var(--sage-dark);
  color: #fffdf9;
  font-size: 17rpx;
}

.bun {
  position: relative;
  width: 136rpx;
  height: 116rpx;
  border: 1rpx solid rgba(85, 66, 47, 0.18);
  border-radius: 48% 52% 42% 44%;
  background: #f6e7cd;
  box-shadow: inset -10rpx -12rpx 0 rgba(113, 79, 45, 0.07), 0 10rpx 16rpx rgba(74, 57, 43, 0.1);
}

.bun-wheat { background: #f5e4c7; }
.bun-corn { background: #e8cf82; }
.bun-purple { background: #a98078; }
.bun-brown { background: #bc845a; }
.bun-green { background: #a8ad7f; }

.bun-fold {
  position: absolute;
  top: 14rpx;
  width: 28rpx;
  height: 36rpx;
  border-left: 3rpx solid rgba(83, 60, 40, 0.18);
  border-radius: 50%;
}

.fold-one { left: 40rpx; transform: rotate(-18deg); }
.fold-two { left: 56rpx; transform: rotate(2deg); }
.fold-three { left: 72rpx; transform: rotate(20deg); }

.product-stock {
  margin-top: 4rpx;
  color: #78716c;
  font-size: 18rpx;
}

.product-name {
  margin-top: 12rpx;
  overflow: hidden;
  font-size: 26rpx;
  line-height: 1.25;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.product-description {
  margin-top: 5rpx;
  color: #78716c;
  font-size: 22rpx;
}

.product-footer {
  display: flex;
  margin-top: 14rpx;
  align-items: center;
  justify-content: space-between;
  gap: 6rpx;
}

.product-price {
  font-size: 30rpx;
}

.product-unit {
  color: #78716c;
  font-size: 17rpx;
}

.quantity-control {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  gap: 6rpx;
}

.quantity-button {
  display: flex;
  width: 52rpx;
  min-width: 52rpx;
  max-width: 52rpx;
  height: 52rpx;
  min-height: 52rpx;
  flex: 0 0 52rpx;
  margin: 0;
  padding: 0;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #d6d3d1;
  border-radius: 50% 45% 48% 44%;
  background: #fffdf9;
  color: var(--stone);
  font-size: 28rpx;
  line-height: 1;
}

.quantity-add {
  border-color: var(--stone);
  background: var(--stone);
  color: #fff;
}

.quantity-value {
  min-width: 24rpx;
  font-size: 20rpx;
  text-align: center;
}

.view-content {
  padding-top: 54rpx;
}

.empty-state {
  margin-top: 34rpx;
}

.empty-title {
  font-size: 38rpx;
}

.empty-button {
  width: 240rpx;
  margin: 30rpx auto 0;
}

.cart-list,
.order-list {
  margin-top: 34rpx;
}

.cart-item {
  display: flex;
  padding: 22rpx;
  align-items: center;
  gap: 20rpx;
}

.cart-visual {
  display: flex;
  width: 122rpx;
  height: 112rpx;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: 46% 54% 48% 52%;
  background: #eee4d8;
}

.mini-bun {
  width: 82rpx;
  height: 72rpx;
}

.cart-info {
  min-width: 0;
  flex: 1;
}

.cart-name {
  font-size: 28rpx;
}

.cart-subtotal {
  margin-top: 8rpx;
  color: #78716c;
  font-size: 22rpx;
}

.checkout-card {
  margin-top: 30rpx;
  padding: 32rpx;
}

.checkout-heading,
.order-heading,
.order-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.checkout-title {
  font-size: 38rpx;
}

.checkout-total {
  font-size: 40rpx;
}

.fulfillment-grid,
.picker-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.fulfillment-grid {
  margin: 30rpx 0;
}

.fulfillment-option {
  display: flex;
  min-height: 126rpx;
  flex-direction: column;
  align-items: flex-start;
  justify-content: center;
  padding: 22rpx;
  border: 1rpx solid #d6d3d1;
  border-radius: 30rpx 40rpx 32rpx 42rpx;
  background: transparent;
  color: #57534e;
  font-size: 25rpx;
  text-align: left;
}

.fulfillment-active {
  border-color: var(--sage-dark);
  background: var(--sage);
  color: var(--stone);
}

.option-note {
  margin-top: 8rpx;
  font-size: 19rpx;
  opacity: 0.75;
}

.submit-button {
  width: 100%;
}

.local-tip {
  margin-top: 20rpx;
  color: #8a8179;
  font-size: 20rpx;
  line-height: 1.6;
  text-align: center;
}

.order-card {
  padding: 30rpx;
}

.order-title {
  font-size: 30rpx;
}

.order-id {
  margin-top: 8rpx;
  color: #8a8179;
  font-size: 20rpx;
}

.order-status {
  padding: 10rpx 20rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  font-weight: 600;
}

.status-new { background: #ead4b9; color: #5d3925; }
.status-preparing { background: #d9decf; color: #384632; }
.status-ready { background: #c8d3bc; color: #2f462d; }
.status-delivering { background: #ded2be; color: #4b3d2c; }
.status-done { background: #e7e5e4; color: #57534e; }

.order-divider {
  margin: 24rpx 0;
  border-top: 1rpx dashed #d6d3d1;
}

.order-summary {
  color: #625d57;
  font-size: 24rpx;
  line-height: 1.7;
}

.order-bottom {
  margin-top: 22rpx;
  color: #78716c;
  font-size: 22rpx;
}

.order-total {
  color: var(--stone);
  font-size: 32rpx;
}

.bottom-nav {
  position: fixed;
  z-index: 20;
  right: var(--page-gutter);
  bottom: calc(14rpx + env(safe-area-inset-bottom));
  left: var(--page-gutter);
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  overflow: hidden;
  border: 1rpx solid #d6d3d1;
  border-radius: 40rpx 48rpx 42rpx 50rpx;
  background: rgba(255, 253, 249, 0.97);
  box-shadow: 0 12rpx 36rpx rgba(77, 65, 51, 0.14);
}

.nav-item {
  position: relative;
  display: flex;
  min-height: 92rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  border-radius: 999rpx;
  background: transparent;
  color: #8a8179;
  font-size: 20rpx;
}

.nav-icon {
  font-family: "Kaiti SC", STKaiti, serif;
  font-size: 30rpx;
}

.nav-active {
  color: var(--sage-dark);
}

.cart-badge {
  position: absolute;
  right: calc(50% - 38rpx);
  top: 12rpx;
  display: flex;
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 7rpx;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: #8c4f3d;
  color: #fff;
  font-size: 17rpx;
}

.product-modal {
  position: fixed;
  z-index: 50;
  inset: 0;
  display: flex;
  padding: 40rpx var(--page-gutter) calc(40rpx + env(safe-area-inset-bottom));
  align-items: center;
  justify-content: center;
  background: rgba(41, 37, 36, 0.5);
}

.product-detail {
  position: relative;
  width: 100%;
  max-width: 620rpx;
  max-height: 88vh;
  overflow-y: auto;
  padding: 24rpx;
  box-shadow: 0 20rpx 60rpx rgba(41, 37, 36, 0.22);
}

.detail-close {
  position: absolute;
  z-index: 3;
  top: 36rpx;
  right: 36rpx;
  display: flex;
  width: 56rpx;
  min-width: 56rpx;
  height: 56rpx;
  min-height: 56rpx;
  padding: 0;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: rgba(255, 253, 249, 0.92);
  color: var(--stone);
  font-size: 34rpx;
  line-height: 1;
}

.detail-visual {
  position: relative;
  display: flex;
  height: 300rpx;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: 36rpx 44rpx 38rpx 46rpx;
  background: #eee4d8;
}

.detail-bun {
  width: 210rpx;
  height: 180rpx;
}

.detail-bun .bun-fold {
  top: 24rpx;
  width: 44rpx;
  height: 56rpx;
}

.detail-bun .fold-one { left: 62rpx; }
.detail-bun .fold-two { left: 86rpx; }
.detail-bun .fold-three { left: 112rpx; }

.detail-category {
  margin-top: 24rpx;
  color: var(--sage-dark);
  font-size: 20rpx;
}

.detail-name {
  margin-top: 8rpx;
  font-size: 40rpx;
}

.detail-description {
  margin-top: 14rpx;
  color: #625d57;
  font-size: 24rpx;
  line-height: 1.7;
}

.detail-stock {
  margin-top: 12rpx;
  color: #8a8179;
  font-size: 21rpx;
}

.detail-footer {
  display: flex;
  margin-top: 26rpx;
  padding-top: 22rpx;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  border-top: 1rpx dashed #d6d3d1;
}

.detail-price {
  font-size: 42rpx;
}

/* 窄屏和矮屏：缩短图片与导航，保证一屏能看到更多商品信息。 */
@media (max-width: 360px), (max-height: 700px) {
  .topbar {
    min-height: 96rpx;
  }

  .brand-mark {
    width: 58rpx;
    height: 58rpx;
  }

  .brand-name {
    font-size: 30rpx;
  }

  .role-button {
    min-width: 124rpx;
  }

  .menu-section {
    padding-top: 30rpx;
  }

  .menu-catalog {
    grid-template-columns: 98rpx minmax(0, 1fr);
    gap: 12rpx;
  }

  .category-chip {
    min-height: 70rpx;
    font-size: 20rpx;
  }

  .product-grid {
    gap: 12rpx;
  }

  .product-card {
    padding: 10rpx;
  }

  .product-visual {
    height: 148rpx;
  }

  .quantity-button {
    width: 48rpx;
    min-width: 48rpx;
    max-width: 48rpx;
    height: 48rpx;
    min-height: 48rpx;
    flex-basis: 48rpx;
  }

  .detail-visual {
    height: 240rpx;
  }

  .bottom-nav .nav-item {
    min-height: 82rpx;
  }
}

/* 平板和横屏：商品自动多列，表单/列表不会被无意义地放大。 */
.service-message {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 14rpx 22rpx;
  background: #fff4d8;
  color: #73551d;
  font-size: 22rpx;
  line-height: 1.5;
}

.service-message-text {
  flex: 1;
}

.service-retry-button {
  flex: none;
  min-width: 112rpx;
  margin: 0;
  padding: 0 20rpx;
  border: 2rpx solid #8b4a22;
  border-radius: 0;
  background: transparent;
  color: #8b4a22;
  font-size: 22rpx;
  line-height: 48rpx;
}

.service-retry-button::after {
  border: 0;
}

.payment-status {
  margin-top: 18rpx;
  color: var(--sage-dark);
  font-size: 23rpx;
  font-weight: 600;
}

.payment-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.secondary-payment-button,
.primary-payment-button {
  flex: 1;
  margin: 0;
  border-radius: 999rpx;
  font-size: 23rpx;
  line-height: 2.5;
}

.secondary-payment-button {
  border: 1rpx solid #b7b0a8;
  background: #fffdf9;
  color: var(--stone);
}

.primary-payment-button {
  background: var(--sage-dark);
  color: #fffdf9;
}

@media (min-width: 600px) {
  .menu-catalog {
    grid-template-columns: 140rpx minmax(0, 1fr);
    gap: 24rpx;
  }

  .product-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .product-visual {
    height: 190rpx;
  }

  .cart-list,
  .order-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
  }

  .bottom-nav {
    right: 50%;
    left: auto;
    width: 680rpx;
    transform: translateX(50%);
  }
}
